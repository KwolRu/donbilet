# ШАБЛОН: жёсткие запреты исходящего текста (детерминированный слой safety).
#
# ЗАЧЕМ ЗДЕСЬ, А НЕ В ПРОМПТЕ: запрет в промпте — вероятностная просьба, которую нельзя
# ни проверить, ни изменить без релиза, и которую обходит инъекция. Запрет в политике —
# проверяемое правило, одинаковое для всех задач и покрытое тестами.
#
# ГРАНИЦА: здесь — ЖЁСТКИЕ, выразимые правилом запреты. Нюансы (вводящие в заблуждение
# обещания, тон, уместность) проверяет модель ПОВЕРХ. Итог: safe = нет нарушений ни там, ни там.

package ai.content.safety

import rego.v1

decision := {
	"safe": count(violations) == 0,
	"violations": sort([v | some v in violations]),
}

# ── Запреты. Каждый — отдельное правило с говорящим именем: имя попадает в журнал
#    и в метрику ai_guardrail_block_total{rule=...}. ────────────────────────────

# Раскрытие цены в первом касании.
violations contains "price_disclosed" if {
	regex.match(`(?i)(\d[\d\s]{2,})\s*(руб|₽|тыс\.?|k\b|к\b)`, input.text)
}

violations contains "price_disclosed" if {
	regex.match(`(?i)\b(от|за)\s+\d{3,}`, input.text)
}

# Гарантии результата.
violations contains "guarantee_claim" if {
	regex.match(`(?i)(гарантиру|100\s*%\s*результат|обязательно\s+получите|точно\s+заработает)`, input.text)
}

# Внешние ссылки в первом касании (антиспам-требование многих каналов).
violations contains "external_link" if {
	regex.match(`(?i)(https?://|www\.)`, input.text)
}

# Персональные данные в исходящем тексте.
violations contains "personal_data" if {
	regex.match(`(?i)\b(паспорт|снилс|инн\s*\d|карт[аы]\s*\d{4})`, input.text)
}

# Давление и манипуляция.
violations contains "pressure_tactics" if {
	regex.match(`(?i)(последний\s+шанс|только\s+сегодня|срочно\s+ответьте|иначе\s+вы\s+потеряете)`, input.text)
}

# Некорректные утверждения о собеседнике.
violations contains "unfounded_claim" if {
	regex.match(`(?i)(у\s+вас\s+точно\s+нет|вы\s+теряете\s+клиентов\s+каждый\s+день)`, input.text)
}

# Длина: сверхдлинное первое касание — само по себе нарушение канала.
violations contains "too_long" if {
	count(input.text) > 1200
}

# ── ОЖИДАЕМЫЙ ВХОД ─────────────────────────────────────────────────────────────
# { "text": "…", "channel": "email", "stage": "first_touch" }
#
# ЗАМЕЧАНИЕ ПО РЕГУЛЯРКАМ: они ловят типовые формулировки, а не все возможные. Это
# осознанно — детерминированный слой закрывает грубые нарушения дёшево и предсказуемо,
# нюансы остаются модели. Не пытаться выразить регуляркой «неуместный тон».
#
# ЧЕГО ЗДЕСЬ НЕТ И НЕ ДОЛЖНО БЫТЬ:
#  - проверки прав пользователя (это guard приложения);
#  - расписания и лимитов (это outbound_send.rego);
#  - утечки секретов (это output-guardrail в коде: он знает РЕАЛЬНЫЕ значения ключей,
#    а политике их передавать нельзя).
