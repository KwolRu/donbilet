// ШАБЛОН: модели AI-слоя (Prisma). Часть схемы, собираемой из частей — не редактировать
// сгенерированный schema.prisma, править этот файл и пересобирать.
//
// ИНВАРИАНТЫ, ЗАШИТЫЕ В СХЕМУ:
//  - ai_models хранит АЛИАСЫ, НЕ физические model ID (иначе смена модели = миграция БД).
//  - ai_routing_policies.model_alias → FK на ai_models.alias: неизвестный алиас не запишется.
//  - prompt_templates: ≤1 active на (workspace_id, key) — ЧАСТИЧНЫЙ UNIQUE, а не дисциплина.
//  - ai_task_executions хранит И алиас, И физическую модель: после fallback они расходятся,
//    и расхождение — самая ценная информация в журнале.
//  - workspace_id = NULL означает «платформенное» — единственное место, где tenant пуст.

/// Проекция конфигурации шлюза для UI. Секретов не содержит.
model AiProvider {
  id        String   @id @default(uuid())
  slug      String   @unique
  label     String
  isEnabled Boolean  @default(true) @map("is_enabled")
  models    AiModel[]
  createdAt DateTime @default(now()) @map("created_at")

  @@map("ai_providers")
}

/// Реестр ЛОГИЧЕСКИХ алиасов шлюза. Физический model ID здесь НЕ хранится намеренно.
model AiModel {
  id                       String  @id @default(uuid())
  /// Логический алиас: app-default / app-fast / app-fallback / app-batch
  alias                    String  @unique
  /// Роль: default | fast | fallback | batch | embed
  role                     String
  providerId               String  @map("provider_id")
  provider                 AiProvider @relation(fields: [providerId], references: [id])
  isEnabled                Boolean @default(true) @map("is_enabled")
  /// Возможности — их нужно ЗНАТЬ до маршрутизации: не всякая резервная модель
  /// поддерживает строгий structured output.
  supportsTools            Boolean @default(true)  @map("supports_tools")
  supportsStructuredOutput Boolean @default(true)  @map("supports_structured_output")
  description              String?

  routingPolicies AiRoutingPolicy[]

  @@map("ai_models")
}

/// Маршрут use case → алиас. Резолв: tenant-override → платформенный дефолт → ОШИБКА.
model AiRoutingPolicy {
  id          String   @id @default(uuid())
  /// NULL = платформенный дефолт.
  workspaceId String?  @map("workspace_id")
  useCase     String   @map("use_case")
  modelAlias  String   @map("model_alias")
  model       AiModel  @relation(fields: [modelAlias], references: [alias])
  isActive    Boolean  @default(true) @map("is_active")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([workspaceId, useCase])
  @@index([useCase, isActive])
  @@map("ai_routing_policies")
}

/// Реестр промптов. Версии ИММУТАБЕЛЬНЫ: правка = новая версия.
model PromptTemplate {
  id              String   @id @default(uuid())
  workspaceId     String?  @map("workspace_id")
  key             String
  version         Int
  /// draft | active | archived
  status          String   @default("draft")
  content         String   @db.Text
  variablesSchema Json?    @map("variables_schema")
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([workspaceId, key, version])
  @@index([key, status])
  @@map("prompt_templates")
  // ТРЕБУЕТСЯ ЧАСТИЧНЫЙ UNIQUE (Prisma его не выражает — добавить SQL-миграцией):
  //   CREATE UNIQUE INDEX prompt_templates_active_uniq
  //     ON prompt_templates (COALESCE(workspace_id, '00000000-0000-0000-0000-000000000000'), key)
  //     WHERE status = 'active';
  // Без него «ровно одна активная версия» держится на дисциплине кода.
}

/// Журнал выполнений — ИСТОЧНИК ПРАВДЫ по стоимости, качеству и идемпотентности.
model AiTaskExecution {
  id             String   @id @default(uuid())
  workspaceId    String   @map("workspace_id")
  taskType       String   @map("task_type")
  /// UNIQUE — это и есть механизм идемпотентности.
  idempotencyKey String   @unique @map("idempotency_key")
  correlationId  String?  @map("correlation_id")
  /// pending | running | completed | failed | needs_review
  status         String   @default("pending")

  /// ЛОГИЧЕСКИЙ алиас — что просили.
  modelAlias     String?  @map("model_alias")
  /// ФИЗИЧЕСКАЯ модель — кто реально ответил (из ЗАГОЛОВКА шлюза, не из тела!).
  model          String?
  provider       String?

  promptKey      String?  @map("prompt_key")
  promptVersion  Int?     @map("prompt_version")
  /// Версии секций знаний + факт усечения — без них результат невоспроизводим.
  knowledgeVersions Json? @map("knowledge_versions")

  promptTokens     Int?     @map("prompt_tokens")
  completionTokens Int?     @map("completion_tokens")
  /// Стоимость ОТ ШЛЮЗА (авторитетна, учитывает fallback), не собственный расчёт.
  costUsd          Decimal? @map("cost_usd") @db.Decimal(12, 6)
  latencyMs        Int?     @map("latency_ms")
  attempts         Int      @default(0)

  guardrailsPassed Boolean? @map("guardrails_passed")
  /// Результат задачи — нужен, чтобы повтор по ключу МОГ ЧТО-ТО ВЕРНУТЬ.
  storedResult     Json?    @map("stored_result")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([workspaceId, status, createdAt(sort: Desc)])
  @@index([taskType, createdAt(sort: Desc)])
  @@map("ai_task_executions")
}

/// Знания тенанта. Секции с приоритетом: prohibitions идут в контекст ПЕРВЫМИ.
model KnowledgeBase {
  id          String   @id @default(uuid())
  workspaceId String   @map("workspace_id")
  /// prohibitions | facts | pricing | timelines | portfolio
  section     String
  content     String   @db.Text
  version     Int      @default(1)
  /// Точка расширения под retrieval. Пока корпус мал — контекст собирается
  /// детерминированно (см. ai-layer-architecture/references/rag.md).
  // embedding Unsupported("vector(1536)")?
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([workspaceId, section])
  @@map("knowledge_base")
}
