# Переменные локальной ИНФРАСТРУКТУРЫ (docker-compose.local.yml).
# В контейнерах живут только nginx, postgres и redis; сервисы и фронтенд
# запускаются с хоста. Их порты задаются в backend/.env и frontend/.env.
#
# Порты вынесены в env, чтобы несколько проектов на этой архитектуре
# поднимались на одной машине одновременно и не дрались за порты.

# ─── Порты, публикуемые наружу ────────────────────────────────────────────────
# nginx — единственная точка входа: http://localhost:${NGINX_HTTP_PORT}
NGINX_HTTP_PORT=8080
POSTGRES_PORT=5433
REDIS_PORT=6379

# ─── Инфраструктура ───────────────────────────────────────────────────────────
POSTGRES_USER=root
POSTGRES_PASSWORD=123456
POSTGRES_DB=__APP_SLUG__
REDIS_PASSWORD=devpass

# Роль приложения без BYPASSRLS: только с ней работают RLS-политики.
# Создать после миграций: cd backend && npm run db:runtime-role
RUNTIME_DB_USER=app_user
RUNTIME_DB_PASSWORD=change-me-runtime

# Ключ шифрования секретов at-rest (shared/src/crypto). Сгенерировать: openssl rand -hex 32
CRYPTO_KEY=

# ─── Прод-сборка (docker-compose.prod.yml) ────────────────────────────────────
# В проде в контейнерах уже всё: и сервисы, и фронтенд.
GHCR_OWNER=your-github-org
BACKEND_IMAGE_TAG=dev
FRONTEND_IMAGE_TAG=dev
