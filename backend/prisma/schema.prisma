// ---- 00-base.prisma ----
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---- 05-platform.prisma ----
// ==================== PLATFORM: workspaces, users, sessions, audit ====================
// Платформенный слой шаблона. Эти модели есть в любом проекте на этой архитектуре
// и меняются редко — доменные сущности живите в отдельных part-файлах (10-*, 20-*, ...).
//
// Workspace — тенант. Резолвится из JWT (claim `workspace_id`), без поддоменов.
// См. docs/adr/ADR-0002-tenancy-workspace-isolation.md.

model Workspace {
  id   String @id @default(uuid())
  slug String @unique
  name String

  users    User[]
  // Доменные связи добавляются здесь по мере роста схемы.
  projects Project[]
  tasks    Task[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("workspaces")
}

enum UserStatus {
  active
  inactive
  blocked
}

model User {
  id       String     @id @default(uuid())
  email    String     @unique
  password String
  name     String
  status   UserStatus @default(active)

  workspaceId String?    @map("workspace_id")
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  sessions Session[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@map("users")
}

// Refresh-сессии (httpOnly cookie / ротация refresh-токенов).
model Session {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshHash String    @map("refresh_hash")
  userAgent   String?   @map("user_agent")
  ip          String?
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("sessions")
}

// Журнал системных событий. `workspaceId` nullable — платформенные события без тенанта.
model SystemEvent {
  id          String   @id @default(uuid())
  workspaceId String?  @map("workspace_id")
  actorUserId String?  @map("actor_user_id")
  type        String
  payload     Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([workspaceId, createdAt])
  @@index([type, createdAt])
  @@map("system_events")
}

// ---- 10-example.prisma ----
// ==================== EXAMPLE DOMAIN: projects + tasks ====================
// ЭТАЛОННЫЙ доменный part-файл. Показывает обязательные правила шаблона:
//
//   1. Каждая бизнес-таблица несёт `workspace_id` — иначе tenant-изоляция не работает.
//   2. Каждая таблица несёт `created_at` / `updated_at`.
//   3. Составной индекс `workspace_id` + (`status` | `created_at`) — под типовые
//      выборки «список сущностей тенанта, отсортированный/отфильтрованный».
//   4. Связь между доменными сущностями — с `onDelete: Cascade` внутри одного тенанта.
//   5. `@@map` на snake_case-имя таблицы, поля — `@map("snake_case")`.
//
// Удалите этот файл и `example-service`, когда появится настоящий домен, либо
// скопируйте его как заготовку: 20-<domain>.prisma, 30-<domain>.prisma, ...

enum ProjectStatus {
  active
  archived
}

model Project {
  id          String        @id @default(uuid())
  workspaceId String        @map("workspace_id")
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  description String?
  status      ProjectStatus @default(active)

  tasks Task[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([workspaceId, status])
  @@index([workspaceId, createdAt])
  @@map("projects")
}

enum TaskStatus {
  todo
  in_progress
  done
}

model Task {
  id          String     @id @default(uuid())
  workspaceId String     @map("workspace_id")
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId   String     @map("project_id")
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  status      TaskStatus @default(todo)
  dueAt       DateTime?  @map("due_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([workspaceId, status])
  @@index([workspaceId, createdAt])
  @@index([projectId, status])
  @@map("tasks")
}
