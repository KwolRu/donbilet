NODE_ENV='development'
COOKIE_DOMAIN='localhost'
COOKIE_SECURE=false

# Имя и домен приложения. Подставляются скриптом `npm run init:project` в корне репо.
APP_NAME='DonBilet'
APP_DOMAIN='donbilet.ru'
# Единый домен приложения (без поддоменов на тенант). Тенант резолвится из JWT.
APP_MAIN_DOMAIN='localhost'

# ─── База данных ──────────────────────────────────────────────────────────────
# Стандартный образ postgres. Первая миграция включает pg_trgm + btree_gist.
#
# ДВА подключения — это осознанно:
#   DATABASE_URL          владелец таблиц. Миграции, сид, служебные скрипты.
#                         RLS-политики к нему НЕ применяются.
#   DATABASE_RUNTIME_URL  роль приложения без BYPASSRLS. Только через неё
#                         работает tenant-изоляция на уровне БД (ADR-0002 §3).
#                         Создать: npm run db:runtime-role
#
# Если DATABASE_RUNTIME_URL пуст, сервисы подключатся владельцем и напишут
# предупреждение в лог: RLS в этом режиме не защищает.
DATABASE_URL="postgresql://root:123456@localhost:5433/donbilet"
POSTGRES_URL="postgresql://root:123456@localhost:5433/donbilet"
DATABASE_RUNTIME_URL="postgresql://app_user:change-me-runtime@localhost:5433/donbilet"
POSTGRES_USER=root
POSTGRES_PASSWORD=123456
POSTGRES_DB=donbilet
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# ─── Redis (BullMQ: очереди, отложенные задачи, rate limiting) ────────────────
# Пароль должен совпадать с REDIS_PASSWORD в корневом .env — именно он попадает
# в `--requirepass` контейнера. Пустой пароль здесь = NOAUTH при старте сервисов.
REDIS_HOST='localhost'
REDIS_PORT=6379
REDIS_PASSWORD='devpass'

# ─── Порты сервисов ───────────────────────────────────────────────────────────
# Диапазон 52xx выбран, чтобы не драться за порты с другими проектами на этой
# же машине: 5000/5001/5006-5011 уже заняты соседним стеком.
GATEWAY_PORT=5200
EXAMPLE_SERVICE_PORT=5201
AUTH_SERVICE_PORT=5207

# Внутренние URL для проксирования gateway → сервис (см. gateway/modules/proxy/proxy.routes.ts).
# На хосте — localhost; в docker gateway переопределяет их на имена сервисов.
AUTH_SERVICE_URL='http://localhost:5207'
EXAMPLE_SERVICE_URL='http://localhost:5201'
NOTIFICATION_SERVICE_URL='http://localhost:5206'
ANALYTICS_SERVICE_URL='http://localhost:5205'
BILLING_SERVICE_URL='http://localhost:5204'

# Внутренние gRPC-адреса (для межсервисных вызовов; контракты — shared/src/proto)
AUTH_SERVICE_GRPC_URL='localhost:51207'

# ─── JWT ──────────────────────────────────────────────────────────────────────
# В токене — claim workspace_id (тенант). Cookie maxAge синхронизируется с TTL.
# Сгенерировать секрет: npm run gen-jwt
JWT_SECRET='change-me-run-npm-run-gen-jwt'
JWT_ACCESS_EXPIRATION='4h'
JWT_REFRESH_EXPIRATION='7d'
JWT_EMAIL_VERIFICATION_EXPIRATION='24h'
JWT_PASSWORD_RESET_EXPIRATION='1h'

# Секрет для межсервисных вызовов в обход публичного API
INTERNAL_RPC_SECRET='change-me-internal'

# Шифрование секретов at-rest (shared/src/crypto, AES-256-GCM).
# Только в .env, никогда в БД/репозитории/логах. Сгенерировать: openssl rand -hex 32
CRYPTO_KEY=

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Разрешаются APP_MAIN_DOMAIN (+ localhost/127.0.0.1 в dev). Доп. origins через запятую.
CORS_ORIGIN=''

# ─── Rate limiting (auth) ─────────────────────────────────────────────────────
# Максимум попыток в окне: вход — 15 мин, регистрация и повторная отправка — 1 час.
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
REGISTER_RATE_LIMIT_MAX_ATTEMPTS=3
RESEND_RATE_LIMIT_MAX_ATTEMPTS=3
SMS_RATE_LIMIT_MAX_ATTEMPTS=3

# ─── Email (notification-service) ─────────────────────────────────────────────
MAIL_HOST='smtp.example.com'
MAIL_PORT=465
MAIL_USER='email'
MAIL_PASSWORD='password'
MAIL_FROM='noreply@donbilet.ru'
MAIL_FROM_NAME='DonBilet'

# Очередь уведомлений BullMQ
# BULLMQ_NOTIFICATIONS_QUEUE=global_notification_dispatch

# ─── S3-совместимое хранилище (вложения, выгрузки) ────────────────────────────
S3_ENDPOINT="https://s3.example.com"
S3_ACCESS_KEY="your-access-key"
S3_SECRET_KEY="your-secret-key"
S3_REGION="ru-7"
S3_BUCKET_NAME="your-bucket"

# ─── Seed ─────────────────────────────────────────────────────────────────────
# Владелец демо-workspace. Обязательны для `npm run db:seed`.
SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_PASSWORD=change-me
