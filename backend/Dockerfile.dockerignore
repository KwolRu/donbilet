# BuildKit читает этот файл при сборке с флагом -f backend/Dockerfile.
# Контекст сборки — корень репозитория, поэтому паттерны должны покрывать всё дерево.

# Зависимости и артефакты сборки (везде)
**/node_modules
**/dist
**/.next
**/out
**/coverage
**/.turbo

# Контроль версий / CI
.git
.gitignore
.github

# Редактор / IDE
.vscode
.idea
*.swp

# Логи
**/*.log
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*

# Артефакты тестов (backend)
backend/test
backend/**/*.spec.ts
backend/**/*.e2e-spec.ts

# Локальные .env / секреты
**/.env
**/.env.*
!**/.env.example

# Локальный Docker / инфра
docker-compose*.yml
backend/infra
deploy

# Frontend (не нужен в backend-образе)
frontend

# Документация
**/README.md
backend/LOCAL_SETUP.md
backend/docs

# Системный мусор ОС
.DS_Store
Thumbs.db
