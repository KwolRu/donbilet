{
  "name": "donbilet-backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "prisma": {
    "seed": "node ./node_modules/ts-node/dist/bin.js --project tsconfig.json prisma/seed.ts base"
  },
  "scripts": {
    "build": "node ./node_modules/@nestjs/cli/bin/nest.js build",
    "build:all": "node ./node_modules/typescript/bin/tsc -p tsconfig.build.json",
    "format": "prettier --write \"microservices/**/*.ts\" \"test/**/*.ts\"",
    "start:gateway": "node ./node_modules/ts-node/dist/bin.js --project tsconfig.json microservices/gateway/src/main.ts",
    "start:gateway:watch": "nodemon --watch microservices/gateway/src --watch microservices/shared --ext ts --signal SIGTERM --exec \"node ./node_modules/ts-node/dist/bin.js --project tsconfig.json microservices/gateway/src/main.ts\"",
    "start:prod:gateway": "node dist/microservices/gateway/src/main.js",
    "start:auth": "node ./node_modules/ts-node/dist/bin.js --project tsconfig.json microservices/auth-service/src/main.ts",
    "start:auth:watch": "nodemon --watch microservices/auth-service/src --watch microservices/shared --ext ts --signal SIGTERM --exec \"node ./node_modules/ts-node/dist/bin.js --project tsconfig.json microservices/auth-service/src/main.ts\"",
    "start:prod:auth": "node dist/microservices/auth-service/src/main.js",
    "start:example": "node ./node_modules/ts-node/dist/bin.js --project tsconfig.json microservices/example-service/src/main.ts",
    "start:example:watch": "nodemon --watch microservices/example-service/src --watch microservices/shared --ext ts --signal SIGTERM --exec \"node ./node_modules/ts-node/dist/bin.js --project tsconfig.json microservices/example-service/src/main.ts\"",
    "start:prod:example": "node dist/microservices/example-service/src/main.js",
    "start:notification": "node ./node_modules/ts-node/dist/bin.js --project tsconfig.json microservices/notification-service/src/main.ts",
    "start:notification:watch": "nodemon --watch microservices/notification-service/src --watch microservices/shared --ext ts --signal SIGTERM --exec \"node ./node_modules/ts-node/dist/bin.js --project tsconfig.json microservices/notification-service/src/main.ts\"",
    "start:prod:notification": "node dist/microservices/notification-service/src/main.js",
    "start:billing": "node ./node_modules/ts-node/dist/bin.js --project tsconfig.json microservices/billing-service/src/main.ts",
    "start:billing:watch": "nodemon --watch microservices/billing-service/src --watch microservices/shared --ext ts --signal SIGTERM --exec \"node ./node_modules/ts-node/dist/bin.js --project tsconfig.json microservices/billing-service/src/main.ts\"",
    "start:prod:billing": "node dist/microservices/billing-service/src/main.js",
    "start:analytics": "node ./node_modules/ts-node/dist/bin.js --project tsconfig.json microservices/analytics-service/src/main.ts",
    "start:analytics:watch": "nodemon --watch microservices/analytics-service/src --watch microservices/shared --ext ts --signal SIGTERM --exec \"node ./node_modules/ts-node/dist/bin.js --project tsconfig.json microservices/analytics-service/src/main.ts\"",
    "start:prod:analytics": "node dist/microservices/analytics-service/src/main.js",
    "lint": "eslint \"microservices/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "gen-jwt": "node -e \"console.log(require('crypto').randomBytes(64).toString('hex'))\"",
    "db:schema:build": "node ./scripts/build-prisma-schema.mjs",
    "db:generate": "bun run db:schema:build && prisma generate",
    "db:migrate": "bun run db:schema:build && prisma migrate dev",
    "db:migrate:deploy": "bun run db:schema:build && prisma migrate deploy",
    "db:migrate:reset": "bun run db:schema:build && prisma migrate reset",
    "db:push": "bun run db:schema:build && prisma db push",
    "db:push:force": "bun run db:schema:build && prisma db push --force-reset",
    "db:seed": "prisma db seed",
    "db:seed:base": "node ./node_modules/ts-node/dist/bin.js --project tsconfig.json prisma/seed.ts base",
    "db:seed:dev": "node ./node_modules/ts-node/dist/bin.js --project tsconfig.json prisma/seed.ts dev",
    "db:runtime-role": "node ./scripts/create-runtime-role.mjs",
    "db:studio": "prisma studio",
    "db:status": "bun run db:schema:build && prisma migrate status",
    "s3:lifecycle": "node ./node_modules/ts-node/dist/bin.js --project tsconfig.json scripts/setup-s3-lifecycle.ts",
    "s3:cors": "node ./node_modules/ts-node/dist/bin.js --project tsconfig.json scripts/setup-s3-cors.ts",
    "local:up": "powershell -ExecutionPolicy Bypass -File ./scripts/local-up.ps1",
    "local:down": "powershell -ExecutionPolicy Bypass -File ./scripts/local-down.ps1",
    "local:restart": "powershell -ExecutionPolicy Bypass -File ./scripts/local-restart.ps1",
    "test:rls": "node --test test/rls-isolation.test.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1022.0",
    "@aws-sdk/lib-storage": "^3.1047.0",
    "@aws-sdk/s3-request-presigner": "^3.1047.0",
    "@elastic/elasticsearch": "^8.19.1",
    "@grpc/grpc-js": "^1.14.0",
    "@grpc/proto-loader": "^0.8.0",
    "@keyv/redis": "^5.0.0",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/cache-manager": "^3.1.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/microservices": "^11.1.6",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.2.3",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "argon2": "^0.44.0",
    "axios": "^1.16.0",
    "bullmq": "^5.58.5",
    "cache-manager": "^7.2.7",
    "cache-manager-redis-yet": "^5.0.0",
    "cheerio": "^1.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "cookie": "^1.1.1",
    "cookie-parser": "^1.4.7",
    "ioredis": "^5.8.1",
    "livekit-server-sdk": "^2.15.5",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.7",
    "p-limit": "^6.2.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.16.3",
    "prisma": "^7.2.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.34.5",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bun": "latest",
    "@types/cookie": "^0.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^7.0.11",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/sharp": "^0.31.1",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.18.1",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "microservices",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
